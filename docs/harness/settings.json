{
  "permissions": {
    "deny": [
      "Bash(gradle *)",
      "Bash(./gradlew *)",
      "Bash(gradlew *)",
      "Bash(sh gradlew *)",
      "Bash(bash gradlew *)",
      "Bash(gradlew.bat *)",
      "Bash(./gradlew.bat *)",
      "Bash(mvn *)",
      "Bash(./mvnw *)",
      "Bash(javac *)",
      "Bash(java *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(vite *)",
      "Edit(/docs/harness/**)",
      "Edit(/docs/inventory/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(**/build.gradle)",
      "Edit(**/build.gradle.kts)",
      "Edit(**/settings.gradle)",
      "Edit(**/gradle.properties)",
      "Edit(**/package.json)",
      "Edit(**/package-lock.json)",
      "Edit(**/yarn.lock)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(//AS-IS_절대경로로_바꿀_것/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/docs/harness/scripts/check.py\""
          }
        ]
      }
    ]
  }
}
